# Absolute production URL — required for correct canonical links, sitemap.xml,
# robots.txt, and Open Graph tags. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Google AdSense. Leave blank to keep the reserved ad slots as placeholders —
# nothing renders (and no AdSense script loads) until both a client id and the
# relevant slot id are set.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
